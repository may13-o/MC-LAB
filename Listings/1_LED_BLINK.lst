  29   1      while(1);
  30   1      }
  31          void lcdcmd(unsigned char value)
  32          {
  33   1      LCD_DATA = value;
  34   1      rs = 0;
  35   1      en = 1;
  36   1      delay(1);
  37   1      en = 0;
