line level    source

   1          #include <reg51.h>
   2          #define LCD_DATA P1
   3          sbit rs = P3^7;
   4          sbit en = P3^6;
   5          void lcdcmd(unsigned char value);
   6          void lcddata(unsigned char value);
   7          void delay(unsigned int);
   8          void main()
   9          {
  10   1      lcdcmd(0x38); // 8-bit mode, 2 lines
  11   1      lcdcmd(0x0C); // Display ON, cursor OFF
  12   1      lcdcmd(0x06); // Increment cursor
